{
  "schemaVersion": 1,
  "id": "anizium",
  "name": "Anizium",
  "version": "1.0.8",
  "author": "falsisdev",
  "description": "Anizium (anizium.co) 4K & 1080p Türkçe Dublaj/Altyazılı anime akışları ve WebVTT altyazıları.",
  "entry": "index.ts",
  "capabilities": [
    "vod",
    "search",
    "subtitles"
  ],
  "contentTypes": [
    "anime"
  ],
  "languages": [
    "tr",
    "en",
    "ja"
  ],
  "domains": [
    "api.anizium.co",
    "anizium.co",
    "*.anizium.co",
    "*.aniziumserver.site",
    "api.ani.zip",
    "kitsu.io",
    "graphql.anilist.co",
    "api.themoviedb.org",
    "raw.githubusercontent.com"
  ],
  "settingsSchema": [
    {
      "key": "aniziumEmail",
      "label": "Anizium E-posta / Kullanıcı Adı",
      "type": "text",
      "placeholder": "ornek@eposta.com",
      "description": "Anizium artık video kaynakları için oturum gerektirir. Hesabınızla giriş yaparak akışları etkinleştirin."
    },
    {
      "key": "aniziumPassword",
      "label": "Anizium Şifre",
      "type": "secret",
      "placeholder": "••••••••"
    },
    {
      "key": "userSession",
      "label": "Oturum Anahtarı (İsteğe Bağlı)",
      "type": "secret",
      "placeholder": "user_session (e-posta/şifre kullanılırsa otomatik alınır)"
    },
    {
      "key": "userProfile",
      "label": "Profil ID (İsteğe Bağlı)",
      "type": "text",
      "placeholder": "user_profile (otomatik alınır)"
    },
    {
      "key": "mirrorUrl",
      "label": "Özel API Adresi",
      "type": "text",
      "placeholder": "https://api.anizium.co"
    }
  ],
  "files": [
    "shared/core/anime-helpers.ts",
    "shared/core/config.ts",
    "shared/core/http.ts",
    "shared/core/plugin-helpers.ts",
    "shared/core/quality.ts",
    "shared/core/text.ts",
    "shared/core/tmdb.ts",
    "shared/extractors/bysezo.ts",
    "shared/extractors/closeload.ts",
    "shared/extractors/okru.ts",
    "shared/extractors/pilavyer.ts",
    "shared/extractors/sibnet.ts",
    "shared/extractors/tauvideo.ts",
    "shared/extractors/video-hosts.ts",
    "shared/extractors/vidmoly.ts",
    "shared/extractors/youtube.ts"
  ],
  "icon": "https://raw.githubusercontent.com/falsisdev/anthology-vessel/main/assets/anizium.png"
}
