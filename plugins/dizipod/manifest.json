{
  "schemaVersion": 1,
  "id": "dizipod",
  "name": "DiziPod",
  "version": "1.0.4",
  "author": "falsisdev",
  "description": "DiziPod (dizipod.com ve player.dizipod.com) üzerinden yabancı dizi ve filmler için doğrudan 1080p HLS akışları.",
  "entry": "index.ts",
  "capabilities": [
    "vod",
    "search"
  ],
  "contentTypes": [
    "series",
    "movie"
  ],
  "languages": [
    "tr",
    "en"
  ],
  "domains": [
    "dizipod.com",
    "player.dizipod.com",
    "*.tyuopix.com",
    "api.themoviedb.org",
    "raw.githubusercontent.com"
  ],
  "settingsSchema": [
    {
      "key": "mirrorUrl",
      "label": "Özel Site Adresi",
      "type": "text",
      "placeholder": "https://dizipod.com"
    }
  ],
  "files": [
    "shared/core/config.ts",
    "shared/core/http.ts",
    "shared/core/plugin-helpers.ts",
    "shared/core/quality.ts",
    "shared/core/text.ts",
    "shared/core/tmdb.ts"
  ],
  "icon": "https://www.google.com/s2/favicons?domain=dizipod.com&sz=128"
}
